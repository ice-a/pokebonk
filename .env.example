# 复制为本地 .env（勿提交）或填入 Vercel 项目设置 → Environment Variables

# 必填：硅基流动 API Key（https://cloud.siliconflow.cn 获取）
SILICONFLOW_API_KEY=sk-xxxxxxxxxxxxxxxx

# 可选：API 基地址（默认官方）
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# 可选：模型（默认 Qwen2.5-7B；可换 deepseek-ai/DeepSeek-V2.5 等）
SILICONFLOW_MODEL=Qwen/Qwen2.5-7B-Instruct

# 可采样参数
AI_TEMPERATURE=0.9
AI_MAX_TOKENS=300

# 客户端事件间隔（秒），会随 /api/generate 响应下发
AI_EVENT_INTERVAL=45
